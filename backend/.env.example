# ---- Required ---------------------------------------------------------------
APP_ENV=production                      # development | test | production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SECRET_KEY=                             # 64+ random chars: python -c "import secrets;print(secrets.token_urlsafe(64))"

# ---- Sessions & cookies -----------------------------------------------------
COOKIE_SECURE=true                      # must be true in production (HTTPS)
COOKIE_SAMESITE=lax                     # lax for same-origin deployments
# COOKIE_DOMAIN=                        # leave unset for same-origin
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
TRUSTED_HOSTS=["erp.example.com"]       # JSON list; ["*"] disables the check
# CORS_ORIGINS=["https://erp.example.com"]  # only if the SPA is served from another origin

# ---- Security limits --------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
MAX_REQUEST_BYTES=10485760
MAX_UPLOAD_BYTES=5242880
UPLOAD_DIR=/app/uploads

# ---- Database ---------------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=15000

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# ---- First-run web setup (optional; the CLI create-admin is an alternative) --
# SETUP_TOKEN=                          # 16+ random chars; remove after setup

# ---- Optional integrations (remain "not configured" until set) --------------
PUBLIC_APP_URL=https://erp.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_STARTTLS=true
